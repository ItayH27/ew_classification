# Google Earth Engine credentials
# Copy this file to .env and fill in your values.

# Your Google Cloud Project ID (required in all cases).
# Find it at https://console.cloud.google.com — it looks like "my-project-123"
GEE_PROJECT=your-gcp-project-id

# Option A (service account — recommended for cluster/CI):
#   1. Create a GCP service account and download the JSON key.
#   2. Register the service account with GEE:
#      https://developers.google.com/earth-engine/guides/service_account
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=path/to/service-account-key.json

# Option B (interactive / application-default — local dev only):
#   Leave GEE_SERVICE_ACCOUNT and GEE_KEY_FILE unset.
#   Run `earthengine authenticate` once in your terminal first.

# HuggingFace token (optional but avoids rate limits when downloading datasets/models)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=your-hf-token-here

# World News API key (stage 4: attribution — news search by location/date)
# Get yours at https://worldnewsapi.com
WORLD_NEWS_API_KEY=your-worldnewsapi-key-here

# Gemini API key (stage 4: attribution — LLM classification of retrieved articles)
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
